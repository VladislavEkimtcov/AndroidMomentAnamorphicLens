<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Find the original photo (to put the copy next to it and move the original to the trash). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Without it Android hides GPS coordinates from photos read through MediaStore. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Optional on Android 12+: lets the user skip the "move to trash?" confirmation. -->
    <uses-permission
        android:name="android.permission.MANAGE_MEDIA"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AnamorphicApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anamorphic"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProcessActivity"
            android:exported="false"
            android:theme="@style/Theme.Anamorphic.Process" />

        <!-- The two share targets: same screen, the alias name selects the mode. -->
        <activity-alias
            android:name=".StretchShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_stretch"
            android:label="@string/share_stretch"
            android:targetActivity=".ProcessActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".UnstretchShareTarget"
            android:exported="true"
            android:icon="@mipmap/ic_unstretch"
            android:label="@string/share_unstretch"
            android:targetActivity=".ProcessActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
